# Q-Shield Configuration
# Copy this file to .env and fill in the values

# Optional: OpenAI API Key for AI assistant features
# The app works without this — rule-based analysis is always available
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Model selection (default: gpt-4o-mini)
QSHIELD_AI_MODEL=gpt-4o-mini

# Optional: Database path (default: qshield.db in project root)
QSHIELD_DB_PATH=qshield.db

# Optional: Max upload size in MB (default: 10)
QSHIELD_MAX_UPLOAD_MB=10

# Optional: Max asset records per upload (default: 5000)
QSHIELD_MAX_RECORDS=5000
